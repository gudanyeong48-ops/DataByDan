import numpy as np

threshold = 0.7
anomaly_count = 0

def detect_fall(anomaly_score):
    global anomaly_count

    if anomaly_score > threshold:
        anomaly_count += 1
    else:
        anomaly_count = 0

    if anomaly_count >= 5:
        print("낙상 감지! 위험 알림 발생")
        return True

    return False

# 이상 탐지 결과 예시
scores = [0.3, 0.4, 0.8, 0.9, 0.85, 0.9, 0.95]

for score in scores:
    detect_fall(score)
