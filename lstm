
import torch
import torch.nn as nn
import numpy as np

# ==================================
# LSTM FALL RISK PREDICTION AI
# ==================================

class FallPredictionAI(nn.Module):

    def __init__(self, input_size=34,
                 hidden_size=128,
                 num_classes=3):

        super().__init__()

        self.lstm = nn.LSTM(
            input_size=input_size,
            hidden_size=hidden_size,
            num_layers=2,
            batch_first=True,
            dropout=0.3
        )

        self.fc = nn.Sequential(
            nn.Linear(hidden_size, 64),
            nn.ReLU(),
            nn.Dropout(0.3),
            nn.Linear(64, num_classes)
        )

    def forward(self, x):

        output, (hidden, cell) = self.lstm(x)

        last_output = output[:, -1, :]

        prediction = self.fc(last_output)

        return prediction


# ==================================
# MODEL INITIALIZATION
# ==================================

model = FallPredictionAI()

criterion = nn.CrossEntropyLoss()

optimizer = torch.optim.Adam(
    model.parameters(),
    lr=0.001
)


# ==================================
# TRAINING FUNCTION
# ==================================

def train_model(model, X, y, epochs=50):

    model.train()

    for epoch in range(epochs):

        optimizer.zero_grad()

        output = model(X)

        loss = criterion(output, y)

        loss.backward()

        optimizer.step()

        if (epoch + 1) % 5 == 0:

            print(
                f"Epoch [{epoch+1}/{epochs}] "
                f"Loss: {loss.item():.4f}"
            )


# ==================================
# PREDICTION FUNCTION
# ==================================

def predict_risk(model, sequence):

    model.eval()

    with torch.no_grad():

        output = model(sequence)

        probabilities = torch.softmax(
            output, dim=1
        )

        prediction = torch.argmax(
            probabilities, dim=1
        ).item()

    labels = [
        "NORMAL",
        "FALL RISK",
        "FALL SUSPECTED"
    ]

    return (
        labels[prediction],
        probabilities[0].numpy()
    )


# ==================================
# TEST WITH RANDOM INPUT
# ==================================

sample = torch.randn(1, 30, 34)

result, probability = predict_risk(
    model, sample
)

print("AI RESULT:", result)
print("PROBABILITY:", probability)
